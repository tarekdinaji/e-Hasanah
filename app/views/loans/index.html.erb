<h1>Loans</h1>

<% if @borrower %>
  <p>Borrower: <%= link_to @borrower.name, @borrower %></p>
  <p><%= link_to "New Loan for #{@borrower.name}", new_borrower_loan_path(@borrower), class: "button" %></p>
<% else %>
  <p><%= link_to "New Loan", new_loan_path, class: "button" %></p>
<% end %>

<table>
  <thead>
    <tr>
      <th>Borrower</th>
      <th>Guarantor</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Installments</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @loans.each do |loan| %>
      <tr>
        <td><%= loan.borrower&.name %></td>
        <td><%= loan.guarantor&.name %></td>
        <td><%= number_to_currency(loan.amount) %></td>
        <td><%= loan.loan_status %></td>
        <td><%= loan.installment_number %></td>
        <td>
          <%= link_to "Show", loan %> |
          <%= link_to "Edit", edit_loan_path(loan) %> 
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
