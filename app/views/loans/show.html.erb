<h1>Loan #<%= @loan.id %></h1>
<p><strong>Borrower:</strong> <%= link_to @loan.borrower.name, @loan.borrower %></p>
<p><strong>Guarantor:</strong> <%= @loan.guarantor.name %></p>
<p><strong>Amount:</strong> <%= number_to_currency(@loan.amount) %></p>
<p><strong>Status:</strong> <%= @loan.loan_status %></p>
<p><strong>Installment Type:</strong> <%= @loan.installment_type %></p>

<p>
  <%= link_to "Installments", loan_installments_path(@loan) %> |
  <%= link_to "Edit", edit_loan_path(@loan) %> |
  <%= link_to "Back", loans_path %>
</p>
