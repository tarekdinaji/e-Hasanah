<h1>Loan Details</h1>

<p><strong>Amount:</strong> <%= @loan.amount %></p>
<p><strong>Installments:</strong> <%= @loan.installment_number %></p>
<p><strong>Installment Amount:</strong> <%= @loan.installment_amount %></p>
<p><strong>Grace Period:</strong> <%= @loan.grace_period_days %> days</p>
<p><strong>Status:</strong> <%= @loan.loan_status %></p>
<p><strong>First Installment:</strong> <%= @loan.first_installment_date %></p>
<p><strong>Last Installment:</strong> <%= @loan.last_installment_date %></p>
<p><strong>Final Installment:</strong> <%= @loan.final_installment_date %></p>
<p><strong>Guarantor:</strong> <%= @loan.guarantor %></p>
<p><strong>Security Type:</strong> <%= @loan.security_type %></p>
<p><strong>Security Details:</strong> <%= @loan.security_details %></p>

<%= link_to 'Edit', edit_loan_path(@loan) %> |
<%= link_to 'Back', loans_path %>
