<%= form_with model: @loan do |f| %>
  <% if @loan.errors.any? %>
    <div class="errors">
      <ul><% @loan.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul>
    </div>
  <% end %>

  <div>
    <%= f.label :borrower_id, "Borrower" %><br>
    <%= f.collection_select :borrower_id, Borrower.all, :id, :name, include_blank: "Select Borrower" %>
  </div>

  <div>
    <%= f.label :guarantor_id, "Guarantor" %><br>
    <%= f.collection_select :guarantor_id, Guarantor.all, :id, :name, include_blank: "Select Guarantor" %>
  </div>

  <div><%= f.label :amount %><br><%= f.number_field :amount, step: :any %></div>
  <div><%= f.label :installment_number %><br><%= f.number_field :installment_number %></div>
  <div><%= f.label :installment_amount %><br><%= f.number_field :installment_amount, step: :any %></div>
  <div><%= f.label :grace_period_days %><br><%= f.number_field :grace_period_days %></div>

  <div><%= f.label :first_installment_date %><br><%= f.date_field :first_installment_date %></div>
  <div><%= f.label :last_installment_date %><br><%= f.date_field :last_installment_date %></div>
  <div><%= f.label :final_installment_date %><br><%= f.date_field :final_installment_date %></div>

  <div><%= f.label :installment_type %><br><%= f.select :installment_type, options_for_select(%w[weekly monthly daily], @loan.installment_type) %></div>

  <div><%= f.label :loan_status %><br><%= f.select :loan_status, options_for_select(%w[complete active halt grace default], @loan.loan_status) %></div>

  <div><%= f.label :security_type %><br><%= f.text_field :security_type %></div>
  <div><%= f.label :security_details %><br><%= f.text_area :security_details %></div>
  <div><%= f.label :stamp_sl %><br><%= f.text_field :stamp_sl %></div>

  <p><%= f.submit %></p>
<% end %>
