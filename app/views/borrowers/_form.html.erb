<%= form_with model: @borrower do |f| %>
    <% if @borrower.errors.any? %>
      <div class="errors">
        <h4><%= pluralize(@borrower.errors.count, "error") %> prevented saving:</h4>
        <ul><% @borrower.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul>
      </div>
    <% end %>
  
    <div><%= f.label :name %><br><%= f.text_field :name %></div>
    <div><%= f.label :phone %><br><%= f.text_field :phone %></div>
    <div><%= f.label :address %><br><%= f.text_area :address %></div>
    <div><%= f.label :nid_number %><br><%= f.text_field :nid_number %></div>
    <div><%= f.label :account_status %><br>
      <%= f.select :account_status, options_for_select(%w[active pending closed], @borrower.account_status) %>
    </div>
  
    <h3>Guarantor (optional)</h3>
    <%= f.fields_for :guarantor do |g| %>
      <div><%= g.label :name %><br><%= g.text_field :name %></div>
      <div><%= g.label :phone %><br><%= g.text_field :phone %></div>
      <div><%= g.label :address %><br><%= g.text_field :address %></div>
      <div><%= g.label :nid_number %><br><%= g.text_field :nid_number %></div>
    <% end %>
  
    <p><%= f.submit %></p>
<% end %>
  